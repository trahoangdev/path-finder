{
  "name": "@pathfinder/server",
  "version": "0.1.0",
  "description": "PathFinder backend — Hono REST API powered by MongoDB Atlas Vector Search + Aggregation Pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "etl:install": "cd etl && pip install -r requirements.txt",
    "etl:all": "cd etl && python 01_generate_trajectories.py && python 02_scrape_itviec.py && python 03_load_skills_roadmap.py && python 04_load_courses.py && python 05_embed_all.py && python 06_create_indexes.py && python 07_compute_transitions.py"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "mongodb": "^6.21.0",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
