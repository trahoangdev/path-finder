# ──────────────────────────────────────────────────────────────
# PathFinder Server — Environment Variables
# Copy this file to `.env` and fill real values.
# ──────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (https://cloud.mongodb.com)
# Region: AWS ap-southeast-1 (Singapore) recommended for VN latency.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pathfinder

# OpenAI (https://platform.openai.com/api-keys)
#   - text-embedding-3-small: $0.02 / 1M tokens, supports `dimensions=768`
#   - gpt-4o-mini:            $0.15 / 1M input, $0.60 / 1M output
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# CORS — comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://pathfinder-vn.vercel.app

# Vector Search index names (created via etl/06_create_indexes.py)
VECTOR_INDEX_SKILLS=vec_skills_desc
VECTOR_INDEX_COURSES=vec_courses_desc
VECTOR_INDEX_JOBS=vec_jobs_desc
VECTOR_INDEX_TRAJECTORIES=vec_trajectory_snapshot

# Rate limit (per-IP per-minute) — only enforced in production
RATE_LIMIT_PER_MINUTE=60

# Optional: override Node's DNS servers if your network leaks 127.0.0.1
# (commonly happens with NordVPN's Threat Protection, AdGuard, etc.).
# Comma-separated. If unset, the server auto-detects broken DNS and falls
# back to public resolvers (1.1.1.1, 8.8.8.8).
# DNS_SERVERS=1.1.1.1,8.8.8.8
